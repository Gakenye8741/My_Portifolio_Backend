### ============================================
### MEDIA API — REST Client Tests
### ============================================
@baseUrl = http://localhost:5000/api
@authUrl = {{baseUrl}}/auth
@mediaUrl = {{baseUrl}}/media
@projectsUrl = {{baseUrl}}/projects

@email = brayogakenye04@gmail.com
@password = hunter2hunter2

# Real project IDs from your DB
@projectId1 = 0345f081-f78b-4e51-83ad-c87ca043a191
@projectId2 = b08668e6-b723-4b0d-8ccf-96542a60e9ef


### ============================================
### 0. LOGIN (must run first — stores session cookie)
### ============================================
# @name login
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}


### ============================================
### 1. ADMIN — CREATE MEDIA (simulating Cloudinary upload result)
### POST /api/media
### Expected: 201 { data: { id, fileName, fileUrl, ... } }
### ============================================
# @name createMedia
POST {{mediaUrl}}
Content-Type: application/json

{
  "fileName": "portfolio-project-screenshot.png",
  "fileUrl": "https://res.cloudinary.com/demo/image/upload/v1234567890/sample.png",
  "fileType": "image/png",
  "fileSize": 145200,
  "publicId": "portfolio/project-screenshot-1"
}


### ============================================
### 2. ADMIN — CREATE SECOND MEDIA (for section image)
### ============================================
# @name createMedia2
POST {{mediaUrl}}
Content-Type: application/json

{
  "fileName": "dashboard-preview.png",
  "fileUrl": "https://res.cloudinary.com/demo/image/upload/v1234567890/dashboard.png",
  "fileType": "image/png",
  "fileSize": 89200,
  "publicId": "portfolio/dashboard-preview"
}


### ============================================
### 3. ADMIN — CREATE (missing fileName, expect 400)
### ============================================
POST {{mediaUrl}}
Content-Type: application/json

{
  "fileUrl": "https://res.cloudinary.com/demo/image/upload/v1234/sample.png"
}


### ============================================
### 4. ADMIN — CREATE (missing fileUrl, expect 400)
### ============================================
POST {{mediaUrl}}
Content-Type: application/json

{
  "fileName": "orphan.png"
}


### ============================================
### 5. ADMIN — CREATE (invalid URL, expect 400)
### ============================================
POST {{mediaUrl}}
Content-Type: application/json

{
  "fileName": "bad.png",
  "fileUrl": "not-a-valid-url"
}


### ============================================
### 6. ADMIN — CREATE (negative fileSize, expect 400)
### ============================================
POST {{mediaUrl}}
Content-Type: application/json

{
  "fileName": "bad-size.png",
  "fileUrl": "https://res.cloudinary.com/demo/image/upload/v1/x.png",
  "fileSize": -100
}


