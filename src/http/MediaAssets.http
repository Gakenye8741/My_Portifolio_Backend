Content-Type: application/json

{
  "sections": [
    {
      "sectionTitle": "Dashboard Preview",
      "explanation": "Here's what the admin dashboard looks like.",
      "mediaId": "{{createMedia2.response.body.$.data.id}}",
      "order": 0
    }
  ]
}


