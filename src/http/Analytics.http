### ============================================
### ANALYTICS API — REST Client Tests
### ============================================
@baseUrl = http://localhost:5000/api
@authUrl = {{baseUrl}}/auth
@analyticsUrl = {{baseUrl}}/analytics

@email = brayogakenye04@gmail.com
@password = hunter2hunter2


### ============================================
### 0. LOGIN (must run first — stores session cookie)
### ============================================
# @name login
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}


### ============================================
### 1. PUBLIC — RECORD VIEW on "/"
### POST /api/analytics/pageview
### Expected: 200 { data: { path: "/", day: "...", count: 1 } }
### ============================================
POST {{analyticsUrl}}/pageview
Content-Type: application/json

{
  "path": "/"
}


### ============================================
### 2. PUBLIC — RECORD VIEW on "/" again (count → 2)
### ============================================
POST {{analyticsUrl}}/pageview
Content-Type: application/json

{
  "path": "/"
}


