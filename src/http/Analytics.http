{
  "path": "/api/projects"
}


### ============================================
### 11. ADMIN — TODAY'S STATS
### GET /api/analytics/today
### Expected: total ≈ 8, topPage = "/" (count 3)
### ============================================
GET {{analyticsUrl}}/today


### ============================================
### 12. ADMIN — SUMMARY
### GET /api/analytics/summary
### Expected: totalViews ≈ 8, uniquePaths = 5, daysTracked = 1
### ============================================
GET {{analyticsUrl}}/summary


### ============================================
### 13. ADMIN — TOP PAGES (last 7 days)
### GET /api/analytics/pages?days=7&limit=10
### Expected: "/" (3), "/projects" (2), "/blog" (1), "/about" (1), "/contact" (1)
### ============================================
GET {{analyticsUrl}}/pages?days=7&limit=10


### ============================================
### 14. ADMIN — TOP PAGES (limit 3)
### ============================================
GET {{analyticsUrl}}/pages?days=7&limit=3


### ============================================
### 15. ADMIN — TOP PAGES (invalid days, expect 400)
### ============================================
GET {{analyticsUrl}}/pages?days=02


### ============================================
### 16. ADMIN — TOP PAGES (invalid limit, expect 400)
### ============================================
GET {{analyticsUrl}}/pages?limit=20


### ============================================
### 17. ADMIN — TIMESERIES (last 7 days)
### GET /api/analytics/timeseries?days=7
### Expected: 7 items, last one has count 8, others have count 0
### ============================================
GET {{analyticsUrl}}/timeseries?days=7


### ============================================
### 18. ADMIN — TIMESERIES (last 30 days)
### ============================================
GET {{analyticsUrl}}/timeseries?days=30


