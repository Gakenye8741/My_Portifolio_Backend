### ============================================
### AUTH API — REST Client Tests
### ============================================
@baseUrl = http://localhost:5000/api/auth
@email = brayogakenye04@gmail.com
@password = hunter2hunter2
@fullName = Gakenye Ndiritu

### ============================================
### 1. REGISTER — happy path (expect 201)
### ============================================
POST {{baseUrl}}/register
Content-Type: application/json

{
  "fullName": "{{fullName}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

### ============================================
### 2. REGISTER — missing fields (expect 400)
### ============================================
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "no-name@test.com"
}

### ============================================
### 3. REGISTER — duplicate email (expect 409)
### ============================================
POST {{baseUrl}}/register
Content-Type: application/json

{
  "fullName": "Someone Else",
  "email": "{{email}}",
  "password": "{{password}}"
}

### ============================================
### 4. REGISTER — short password (expect 400)
### ============================================
POST {{baseUrl}}/register
Content-Type: application/json

{
  "fullName": "Shorty",
  "email": "shorty@test.com",
  "password": "123"
}

### ============================================
### 5. LOGIN — happy path (expect 200 + Set-Cookie)
### ============================================
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### ============================================
### 6. LOGIN — wrong password (expect 401)
### ============================================
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrongpassword"
}

### ============================================
### 7. LOGIN — unknown email (expect 401)
### ============================================
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "ghost@test.com",
  "password": "{{password}}"
}

### ============================================
### 8. ME — with cookie (expect 200)
### ============================================
# @name me
GET {{baseUrl}}/me

### ============================================
### 9. ME — without cookie (expect 401)
### ============================================
# To test this, first run request #10 (logout), then run this one.
GET {{baseUrl}}/me

### ============================================
### 10. LOGOUT (expect 204)
### ============================================
POST {{baseUrl}}/logout

### ============================================
### 11. ME — after logout (expect 401)
### ============================================
GET {{baseUrl}}/me