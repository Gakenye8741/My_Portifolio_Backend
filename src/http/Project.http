### ============================================
### PROJECTS API — REST Client Tests
### ============================================
@baseUrl = http://localhost:5000/api
@authUrl = {{baseUrl}}/auth
@projectsUrl = {{baseUrl}}/projects

@email = brayogakenye04@gmail.com
@password = hunter2hunter2

@projectId = {{createProject.response.body.$.data.id}}
@projectSlug = portfolio-backend-api-v2


### ============================================
### 0. LOGIN (must run first — stores session cookie)
### ============================================
# @name login
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}


### ============================================
### 1. PUBLIC — LIST PROJECTS (empty list initially)
### GET /api/projects
### ============================================
GET {{projectsUrl}}


### ============================================
### 2. PUBLIC — LIST WITH FILTERS
### GET /api/projects?status=published&featured=true&limit=5&page=1
### ============================================
GET {{projectsUrl}}?status=published&featured=true&limit=5&page=1


### ============================================
### 3. PUBLIC — SEARCH
### GET /api/projects?search=react
### ============================================
GET {{projectsUrl}}?search=react


### ============================================
### 4. PUBLIC — SORT BY VIEWS
### GET /api/projects?sortBy=viewCount&sortOrder=desc
### ============================================
GET {{projectsUrl}}?sortBy=viewCount&sortOrder=desc


### ============================================
### 5. PUBLIC — INVALID FILTER (expect 400)
### GET /api/projects?status=garbage
### ============================================
GET {{projectsUrl}}?status=garbage


### ============================================
### 6. ADMIN — CREATE PROJECT (expect 201)
### POST /api/projects
### ============================================
# @name createProject
POST {{projectsUrl}}
Content-Type: application/json

{
  "title": "Portfolio Backend API",
  "mainDescription": "A production-grade PERN stack backend with auth, sessions, projects, posts, and analytics.",
  "status": "published",
  "isFeatured": true,
  "links": [
    {
      "label": "GitHub",
      "url": "https://github.com/gakenye/portfolio-backend",
      "type": "github_fullstack"
    },
    {
      "label": "Live Demo",
      "url": "https://gakenye-ndiritu.co.ke",
      "type": "live_demo"
    }
  ],
  "sections": [
    {
      "sectionTitle": "Overview",
      "explanation": "This is a full PERN stack backend powering my portfolio website.",
      "order": 0
    },
    {
      "sectionTitle": "Tech Stack",
      "explanation": "PostgreSQL, Express, React, Node.js, Drizzle ORM.",
      "order": 1
    }
  ],
  "timeline": [
    {
      "title": "Started",
      "description": "Kicked off the project"
    },
    {
      "title": "Auth complete",
      "description": "Sessions + bcrypt working"
    }
  ]
}


### ============================================
### 7. ADMIN — CREATE (missing title, expect 400)
### ============================================
POST {{projectsUrl}}
Content-Type: application/json

{
  "mainDescription": "No title provided"
}


### ============================================
### 8. ADMIN — CREATE (invalid URL, expect 400)
### ============================================
POST {{projectsUrl}}
Content-Type: application/json

{
  "title": "Bad URLs",
  "mainDescription": "Test invalid link",
  "links": [
    { "label": "Broken", "url": "not-a-url" }
  ]
}


### ============================================
### 9. PUBLIC — GET BY SLUG (expect 200, view++)
### GET /api/projects/slug/:slug
### ============================================
GET {{projectsUrl}}/slug/{{projectSlug}}


### ============================================
### 10. PUBLIC — GET BY SLUG (nonexistent, expect 404)
### ============================================
GET {{projectsUrl}}/slug/this-does-not-exist


### ============================================
### 11. ADMIN — GET BY ID (expect 200)
### GET /api/projects/:id
### ============================================
GET {{projectsUrl}}/{{projectId}}


### ============================================
### 12. ADMIN — GET BY ID (without cookie, expect 401)
### ============================================
# Run this AFTER logging out — or comment out the cookie
GET {{projectsUrl}}/{{projectId}}


### ============================================
### 13. ADMIN — STATS (expect 200)
### GET /api/projects/admin/stats
### ============================================
GET {{projectsUrl}}/admin/stats


### ============================================
### 14. ADMIN — UPDATE (expect 200)
### PUT /api/projects/:id
### ============================================
PUT {{projectsUrl}}/{{projectId}}
Content-Type: application/json

{
  "title": "Portfolio Backend API (v2)",
  "mainDescription": "Updated description. Now with analytics and SEO."
}


### ============================================
### 15. ADMIN — UPDATE (nonexistent id, expect 404)
### ============================================
PUT {{projectsUrl}}/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "title": "Ghost"
}


### ============================================
### 16. ADMIN — TOGGLE FEATURED (expect 200)
### PATCH /api/projects/:id/featured
### ============================================
PATCH {{projectsUrl}}/{{projectId}}/featured


### ============================================
### 17. ADMIN — TOGGLE FEATURED AGAIN (back to original)
### ============================================
PATCH {{projectsUrl}}/{{projectId}}/featured


### ============================================
### 18. ADMIN — UPDATE STATUS → draft (expect 200)
### PATCH /api/projects/:id/status
### ============================================
PATCH {{projectsUrl}}/{{projectId}}/status
Content-Type: application/json

{
  "status": "draft"
}


### ============================================
### 19. PUBLIC — LIST (draft should NOT appear)
### ============================================
GET {{projectsUrl}}


### ============================================
### 20. ADMIN — LIST WITH includeDeleted=true
### ============================================
GET {{projectsUrl}}?includeDeleted=true


### ============================================
### 21. ADMIN — UPDATE STATUS back → published
### ============================================
PATCH {{projectsUrl}}/{{projectId}}/status
Content-Type: application/json

{
  "status": "published"
}


### ============================================
### 22. PUBLIC — LIST (published reappears)
### ============================================
GET {{projectsUrl}}


### ============================================
### 23. ADMIN — SOFT DELETE (expect 204)
### DELETE /api/projects/:id
### ============================================
DELETE {{projectsUrl}}/{{projectId}}


### ============================================
### 24. PUBLIC — LIST (deleted gone)
### ============================================
GET {{projectsUrl}}


### ============================================
### 25. PUBLIC — GET BY SLUG (deleted → 404)
### ============================================
GET {{projectsUrl}}/slug/{{projectSlug}}


### ============================================
### 26. ADMIN — RESTORE (expect 200)
### POST /api/projects/:id/restore
### ============================================
POST {{projectsUrl}}/{{projectId}}/restore


### ============================================
### 27. PUBLIC — LIST (restored reappears)
### ============================================
GET {{projectsUrl}}


### ============================================
### 28. ADMIN — HARD DELETE (expect 204)
### DELETE /api/projects/:id/hard
### ============================================
DELETE {{projectsUrl}}/{{projectId}}/hard


### ============================================
### 29. ADMIN — GET BY ID after hard delete (expect 404)
### ============================================
GET {{projectsUrl}}/{{projectId}}


### ============================================
### 30. AUTH — LOGOUT (clean up session)
### ============================================
POST {{authUrl}}/logout

### GET /api/projects/slug/portfolio-backend-api
GET {{projectsUrl}}/slug/portfolio-backend-api

### Replace project links
PUT {{projectsUrl}}/{{projectId}}
Content-Type: application/json

{
  "links": [
    {
      "label": "GitHub",
      "url": "https://github.com/gakenye/portfolio-backend-v2",
      "type": "github_fullstack"
    },
    {
      "label": "API Docs",
      "url": "https://docs.gakenye-ndiritu.co.ke",
      "type": "documentation"
    },
    {
      "label": "Figma Design",
      "url": "https://figma.com/file/xyz",
      "type": "design"
    }
  ]
}